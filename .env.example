# API Gateway port
HOBOM_API_GATEWAY_PORT=9090

# Allowed CORS origin
HOBOM_CLIENT_HOST=http://localhost:3000

# Upstream service hosts
HOBOM_API_SERVER_HOST=http://localhost:8080/hobom-system-backend/api/v1
HOBOM_INTERNAL_API_SERVER_HOST=http://localhost:8081/hobom-internal/api/v1
HOBOM_SPACE_API_SERVER_HOST=http://localhost:8083/api/v1

# Dynamic proxy routes (optional — overrides/extends individual host env vars)
# Format: serviceName=http://host/path,anotherService=http://host2/path
# PROXY_ROUTES=

# API gateway authentication key (generate a strong random value for each environment)
HOBOM_API_GATEWAY_KEY=

# Rate limiting (requests per TTL window per IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
